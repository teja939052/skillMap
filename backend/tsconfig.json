{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "paths": {
      "@skill-map/contracts": ["../shared/contracts/src"],
      "@skill-map/config": ["../shared/config/src"],
      "@skill-map/utils": ["../shared/utils/src"]
    }
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "src/scripts"],
  "references": [
    { "path": "../shared/contracts" },
    { "path": "../shared/config" },
    { "path": "../shared/utils" }
  ]
}
